{
  "name": "aranplus-samsung",
  "version": "0.7.7",
  "private": true,
  "description": "ARAN+ for Samsung Tizen TVs: a cosy, Netflix-style IPTV player built on the Xtream Codes API.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:syntax": "es-check es2018 \"dist/*.js\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:syntax",
    "package": "node tools/tizen.mjs package",
    "install:tv": "node tools/tizen.mjs install",
    "run:tv": "node tools/tizen.mjs run",
    "debug:tv": "node tools/tizen.mjs debug",
    "images": "python3 tools/make_images.py",
    "screens": "node dev/screens.mjs",
    "helper": "node helper/aranplus-helper.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "es-check": "^9.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
