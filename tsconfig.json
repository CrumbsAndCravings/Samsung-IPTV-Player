{
  "compilerOptions": {
    // The TV is a 2020 Q60T (Tizen 5.5, Chromium 69): ES2018, plus Array.flat and
    // String.trimStart from ES2019. Object.fromEntries (Chromium 73) is not there.
    "target": "ES2018",
    "lib": ["ES2018", "ES2019.Array", "ES2019.String", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
